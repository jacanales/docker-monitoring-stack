{
  "name": "jacanales/statsd",
  "type": "library",
  "description": "PHP client for StatsD",
  "keywords": [
    "monitoring",
    "statsd",
    "metrics"
  ],
  "homepage": "http://www.jacd.es/",
  "license": "MIT",
  "authors": [
    {
      "name": "Jesús Antonio Canales Diez",
      "email": "contact@jacd.es"
    }
  ],
  "require": {
    "php": ">= 8.4.1",
    "slickdeals/statsd": "^3.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "phpspec/prophecy-phpunit": "^2.5",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "Jacanales\\StatsD\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\unit\\Jacanales\\StatsD\\": "tests/unit",
      "tests\\integration\\Jacanales\\StatsD\\": "tests/integration",
      "Demo\\StatsD\\": "examples/"
    }
  }
}
